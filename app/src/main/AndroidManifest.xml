<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.opengles.aep" android:required="false" />

    <!-- A PEDIDO EXPLÍCITO DEL USUARIO: vibración real (no la sutil de
         `LocalHapticFeedback`, pensada para acuses de clic de UI) al
         arrastrar un ícono minimizado sobre la zona de "Eliminar" — ver
         [FloatingToolWindow] en EditorScreen.kt. Permiso "normal" (no
         peligroso): con declararlo acá alcanza, no hace falta pedirlo
         en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Fondo del proyecto por cámara ("Nuevo proyecto" → "Elige un fondo"
         → cámara en vivo, ver BackgroundPickerSection.kt): permiso
         PELIGROSO, se pide en tiempo de ejecución antes de lanzar
         ActivityResultContracts.TakePicture (ver MainActivity). Declararlo
         acá es necesario pero no suficiente por sí solo.
         `android.hardware.camera` va `required="false"` a propósito —
         mismo criterio que `opengles.aep` arriba: un equipo sin cámara
         (tablet de escritorio, emulador sin cámara) tiene que poder seguir
         instalando y usando la app con normalidad, solo sin la opción de
         cámara en el selector de fondo (ver comprobación en runtime con
         PackageManager.hasSystemFeature en BackgroundPickerSection). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Lo exige android.media.audiofx.LoudnessEnhancer (AudioPreviewPlayer, reproductor de respaldo
         cuando no carga la biblioteca nativa): refuerzo de volumen por encima del 100 %. Si ese respaldo
         se retira algún día, este permiso sobra. El motor nativo (Oboe) no lo necesita. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".OlyzeApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Olyze"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true">
        <!-- API 36 (Android 16): con targetSdk 36 el "atrás" predictivo queda activado por defecto y el sistema deja de
             llamar a `onBackPressed()` / de enviar `KEYCODE_BACK`. Toda la navegación de la app pasa por
             `OnBackPressedDispatcher` (los `BackHandler` de Compose, ver GuardedBackHandler), que es el camino compatible,
             así que se DECLARA activado en vez de depender del valor por defecto de cada versión de Android: mismo
             comportamiento en API 33-36 y sin sorpresas el día que cambie el valor por defecto. -->

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name_launcher"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|density|uiMode">
            <!-- API 36: en pantallas con ancho mínimo >= 600 dp (tablets, plegables abiertos, ventanas de escritorio) el
                 sistema IGNORA `screenOrientation`, `resizeableActivity=false` y las relaciones de aspecto de un app con
                 targetSdk 36. El editor está diseñado y probado en vertical (línea de tiempo + preview apilados); un
                 diseño adaptable a horizontal es un trabajo de producto aparte (Fase 3 de docs/MIGRACION_API36.md).
                 Esta propiedad es el mecanismo OFICIAL y por-Activity de la plataforma para conservar el comportamiento
                 anterior mientras tanto. Es TEMPORAL: se elimina para apps con targetSdk 37, así que no sirve como
                 solución definitiva. En teléfonos (sw < 600 dp) no tiene efecto: `screenOrientation` sigue vigente.
                 `windowSoftInputMode=adjustResize`: con borde a borde obligatorio el teclado se entrega como inset IME,
                 que la UI consume con `imePadding()` (ver EditorScreen/ProjectsScreen).
                 `configChanges` ampliado: una ventana redimensionable (pantalla dividida, escritorio, plegado) cambia
                 smallestScreenSize/screenLayout/density/uiMode sin que la Activity deba recrearse — Compose y el
                 contexto GL lo absorben por sí solos y recrearla reiniciaría el motor de audio y el preview. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- SEGURIDAD: estos filtros VIEW NO declaran BROWSABLE (una página web
                 podía disparar la importación con un `intent://` hacia cualquier
                 `content://` accesible) ni el esquema `file://` (prohibido entre apps
                 desde API 24; solo permitía a una app antigua apuntar el importador a
                 rutas internas). Abrir un adjunto desde Gmail/WhatsApp/Drive usa un
                 `content://` explícito y no los necesita. -->
            <!-- Compartir: recibir un proyecto ".olycs" que otra persona (o
                 uno mismo, desde otro dispositivo) mandó por WhatsApp,
                 Telegram, Drive, correo, Bluetooth, etc. y se abre
                 tocándolo directamente (típicamente dispara ACTION_VIEW con
                 el mime type detectado). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-olycs" />
            </intent-filter>

            <!-- Mismo caso, pero cuando el archivo llega con un mime type
                 genérico (application/octet-stream — muy común al bajar
                 adjuntos de apps de mensajería) y solo se puede reconocer
                 por su extensión ".olycs". `android:host="*"` es
                 OBLIGATORIO: sin host, Android IGNORA `pathPattern` y el
                 filtro aceptaría CUALQUIER archivo (mimeType */*), haciendo
                 que Olyze aparezca en "Abrir con" para todo tipo de archivo. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.olycs" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Recibir el archivo desde la hoja "Compartir" nativa de
                 OTRA app (p. ej. reenviado desde el visor de adjuntos de
                 Gmail o Telegram usando su propio botón "Compartir"). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-olycs" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
