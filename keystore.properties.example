# Copia este archivo como `keystore.properties` (está en .gitignore) y rellénalo. NUNCA lo subas al repositorio.
# En CI se usan variables de entorno equivalentes: OLYZE_KEYSTORE_FILE, OLYZE_KEYSTORE_PASSWORD, OLYZE_KEY_ALIAS, OLYZE_KEY_PASSWORD.
#
# Ruta absoluta, o relativa a la raíz del proyecto.
storeFile=/ruta/segura/olyze-upload.jks
storePassword=CAMBIAR
keyAlias=olyze-upload
# Opcional en almacenes PKCS12 (si se omite, se usa storePassword).
keyPassword=CAMBIAR
